// See https://go.microsoft.com/fwlink/?LinkId=733558 for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "inputs": [// See https://code.visualstudio.com/docs/editor/variables-reference for the documentation about the variables used in this file
        {
            "id": "moduleDir",
            "type": "promptString",
            "description": "Module subdir (relative to the workspace)",
            "default": "${cwd}"
        }
        ,
        {
            "id": "binDir",
            "type": "promptString",
            "description": "Binary dir (where binaries are created; must exist)",
            "default": ".bin"
        }
    ],
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: /usr/bin/g++"
        }
        ,
        {
            "type": "cppbuild",
            "label": "C/C++: g++ {workspaceFolder}/src/*",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "src/*",
                "-o", "${workspaceFolderBasename}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: /usr/bin/g++"
        }
        ,
        {
            "type": "cppbuild",
            "label": "C/C++: g++ {input:moduleDir}/src/*",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${input:moduleDir}/src/*",
                "-o", "${input:binDir}/${input:moduleDir}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: /usr/bin/g++"
        }
    ]
}