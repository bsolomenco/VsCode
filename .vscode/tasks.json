// See https://go.microsoft.com/fwlink/?LinkId=733558 for the documentation about the tasks.json format
// See https://code.visualstudio.com/docs/editor/variables-reference for the documentation about the variables used in this file
{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "moduleDir",
            "type": "promptString",
            "description": "Module subdir (relative to the workspace)",
            "default": "${cwd}"
        },
        {
            "id": "binDir",
            "type": "promptString",
            "description": "Binary dir (where binaries are created; must exist)",
            "default": ".bin"
        },
        {
            "id": "selectedDir_path",
            "type": "command",
            "command": "selectedDir.path"   //needs extension to provide selectedDir.path command
        },
        {
            "id": "selectedDir_name",
            "type": "command",
            "command": "selectedDir.name"   //needs extension to provide selectedDir.name command
        }
    ],
    "tasks": [
        {
            "type": "cppbuild",
            "label": "g++ {workspaceFolder}/src/* -o ${workspaceFolderBasename}",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "src/*",
                "-o",
                "${workspaceFolderBasename}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "C/C++build all files in src/"
        },
        {
            "type": "cppbuild",
            "label": "g++ {inputDir}/src/*",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${input:moduleDir}/src/*",
                "-o",
                "${input:binDir}/${input:moduleDir}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "C/C++ build all from input dir"
        },
        {
            "label": "selectedDir",
            "type": "shell",
            "command": "echo selectedDir: path=${input:selectedDir_path}, name=${input:selectedDir_name}",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "echo selectedDir: path=${input:selectedDir_path}, name=${input:selectedDir_name}"
        },
        {
            "type": "cppbuild",
            "label": "g++ {selectedDir}/src/*",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${input:selectedDir_path}/src/*",
                "-o",
                "${input:binDir}/${input:selectedDir_name}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "build all from selected dir: g++ ${selectedDir_path}/src/* -o ${input:binDir}/${input:selectedDir_name}"
        },
        {
            "label": "defaultDir",
            "type": "shell",
            "command": "echo defaultDir: abs=${command:DefaultDir.abs}, rel=${command:DefaultDir.rel}, name=${command:DefaultDir.name}",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "echo defaultDir: abs=${command:DefaultDir.abs}, rel=${command:DefaultDir.rel}, name=${command:DefaultDir.name}"
        },
        {
            "type": "cppbuild",
            "label": "g++ {command:DefaultDir.rel}/src/*",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${command:DefaultDir.rel}/src/*",
                "-o", "${input:binDir}/${command:DefaultDir.name}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "C/C++build all from default selected dir: g++ ${command:DefaultDir.rel}/src/* -o ${input:binDir}/${command:DefaultDir.name}"
        }
    ]
}