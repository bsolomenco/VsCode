{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.bin/Exe1", /*adjust this!!!*/
            "args": [
                //add arguments here if needed
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {"name": "TEST_ENV", "value": "test_env_value"}
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            //"preLaunchTask": "C/C++: g++ {input:moduleDir}/src/*" //adjust this (or remove it ... but make sure you run it manually before debugging)
        }
        ,
        {
            "name": "(gdb) Launch default dir",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.bin/${command:DefaultDir.name}",
            "args": [
                //add arguments here if needed
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {"name": "TEST_ENV", "value": "test_env_value"}
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "g++ {command:DefaultDir.rel}/src/*" //adjust this (or remove it ... but make sure you run it manually before debugging)
        }
    ]
}